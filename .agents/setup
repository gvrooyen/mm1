#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "Installing native build dependencies..."
export DEBIAN_FRONTEND=noninteractive
if (( EUID == 0 )); then
  apt=(apt-get)
else
  apt=(sudo apt-get)
fi
"${apt[@]}" update -qq
"${apt[@]}" install -y --no-install-recommends \
  build-essential \
  ca-certificates \
  curl \
  libwayland-dev \
  libxkbcommon-dev \
  libxkbcommon-x11-0 \
  pkg-config \
  wayland-protocols

export PATH="$HOME/.cargo/bin:$PATH"

if ! command -v rustup >/dev/null 2>&1; then
  echo "Installing rustup..."
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --profile minimal --no-modify-path
fi

profile_marker="# mm1 Rust toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# mm1 Rust toolchain
export PATH="$HOME/.cargo/bin:$PATH"
EOF
fi

echo "Installing the pinned Rust toolchain..."
rustup set profile minimal
rustup toolchain install "$(cat "$repo_root/rust-toolchain.toml" | sed -n 's/^channel = "\(.*\)"/\1/p')" --component rustfmt

echo "Fetching and building dependencies..."
if [[ -f "$repo_root/Cargo.lock" ]]; then
  cargo_options=(--locked)
else
  cargo_options=()
fi
cargo fetch --manifest-path "$repo_root/Cargo.toml" "${cargo_options[@]}"
cargo build --manifest-path "$repo_root/Cargo.toml" "${cargo_options[@]}"

echo "Setup complete."
